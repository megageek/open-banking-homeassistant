#!/bin/bash

# script/test: Run project tests
#
# Runs pytest with project configuration. Automatically cleans up package
# installations after test run to prevent Home Assistant from loading the
# wrong version.
#
# Usage:
#   ./script/test [OPTIONS] [PYTEST_OPTIONS]
#
# Options:
#   --cov           Generate coverage report (terminal output)
#   --cov-html      Generate HTML coverage report in htmlcov/
#   --live          Run only live API tests (requires OPEN_BANKING_SECRET_ID and OPEN_BANKING_SECRET_KEY)
#
# Examples:
#   ./script/test
#   ./script/test -v
#   ./script/test --cov
#   ./script/test --cov-html
#   ./script/test --live
#   ./script/test --cov -k test_midnight
#   ./script/test tests/test_cache_validity.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
# shellcheck source=script/.lib/integration.sh
source "$SCRIPT_DIR/.lib/integration.sh"

activate_venv
PYTHON="$VIRTUAL_ENV/bin/python"

# Parse coverage flags
COVERAGE_ARGS=()
PYTEST_ARGS=()
LIVE_TESTS=false

while [[ $# -gt 0 ]]; do
    case $1 in
    --cov)
        COVERAGE_ARGS+=("--cov=$INTEGRATION_PATH" "--cov-report=term-missing")
        shift
        ;;
    --cov-html)
        COVERAGE_ARGS+=("--cov=$INTEGRATION_PATH" "--cov-report=html")
        shift
        ;;
    --live)
        LIVE_TESTS=true
        shift
        ;;
    *)
        PYTEST_ARGS+=("$1")
        shift
        ;;
    esac
done

if [[ "$LIVE_TESTS" == "true" ]]; then
    # Non-interactive shells do not load the project-managed Bash/Zsh startup files.
    # shellcheck source=.devcontainer/_load_env.sh
    source "$PWD/.devcontainer/_load_env.sh"
    PYTEST_ARGS+=("-m" "live_api")
else
    PYTEST_ARGS+=("-m" "not live_api")
fi

# Check if pytest and the Home Assistant test plugin are available
if ! "$PYTHON" -c "import pytest, pytest_homeassistant_custom_component" 2>/dev/null; then
    log_info "Test dependencies not found. Installing..."
    uv pip install --requirement requirements_test.txt
fi

# Run pytest with project configuration
if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]]; then
    log_header "Running tests with coverage"
else
    log_header "Running tests"
fi
echo ""

run_hook "test" "pre"
echo ""
"$PYTHON" -m pytest "${COVERAGE_ARGS[@]}" "${PYTEST_ARGS[@]}"

run_hook "test" "post"

log_success "Tests completed"

if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]] && [[ " ${COVERAGE_ARGS[*]} " =~ " --cov-report=html " ]]; then
    echo ""
    log_success "Coverage report generated in htmlcov/index.html"
fi

# Clean up any accidental package installation from pytest/test dependencies
# This prevents Home Assistant from loading the installed version instead of
# the development version from custom_components/
"$SCRIPT_DIR/clean" --minimal
